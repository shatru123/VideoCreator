<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VideoCreator.App.ViewModels;assembly=VideoCreator.App"
             xmlns:controls="clr-namespace:VideoCreator.App.Controls;assembly=VideoCreator.App"
             xmlns:converters="clr-namespace:VideoCreator.App.Converters;assembly=VideoCreator.App"
             xmlns:clips="clr-namespace:VideoCreator.Core.Models.Clips;assembly=VideoCreator.Core"
             xmlns:enums="clr-namespace:VideoCreator.Core.Enums;assembly=VideoCreator.Core"
             x:Class="VideoCreator.App.Views.MainEditorView"
             x:DataType="vm:EditorViewModel"
             x:Name="EditorRoot"
             Background="#0B0E14">

    <Grid RowDefinitions="Auto,*,Auto,240">
        <!-- 1. Top Application Toolbar -->
        <Border Grid.Row="0" Background="#11141D" Padding="16,10" BorderBrush="#1E2330" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Project Name & Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="🎬 VideoCreator Studio" FontWeight="Black" FontSize="16" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    <Border Background="#1E2433" CornerRadius="6" Padding="10,4">
                        <TextBox Text="{Binding CurrentProject.Metadata.Name}" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Center Undo / Redo & Aspect Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding UndoCommand}" Content="↩ Undo" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="12"/>
                    <Button Command="{Binding RedoCommand}" Content="↪ Redo" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="12"/>

                    <Border Width="1" Height="20" Background="#262D3D" Margin="8,0"/>

                    <Button Command="{Binding ChangeAspectCommand}" CommandParameter="{x:Static enums:AspectRatio.Ratio16x9}" Content="16:9 Landscape" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="11"/>
                    <Button Command="{Binding ChangeAspectCommand}" CommandParameter="{x:Static enums:AspectRatio.Ratio9x16}" Content="9:16 Reel/Shorts" Background="#1E2433" Foreground="#60A5FA" Padding="10,6" CornerRadius="6" FontSize="11" FontWeight="Bold"/>
                    <Button Command="{Binding ChangeAspectCommand}" CommandParameter="{x:Static enums:AspectRatio.Ratio1x1}" Content="1:1 Square" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="11"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{Binding SaveCommand}" Content="💾 Save" Background="#1E293B" Foreground="#E2E8F0" Padding="14,8" CornerRadius="8" FontSize="12" FontWeight="SemiBold"/>
                    <Button Command="{Binding OpenExportCommand}" Content="🚀 Export MP4" Background="#4F46E5" Foreground="#FFFFFF" Padding="18,8" CornerRadius="8" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main 3-Pane Body: Left Library | Center Preview | Right Inspector -->
        <Grid Grid.Row="1" ColumnDefinitions="310,*,330">
            <!-- Left: Media Library Panel -->
            <Border Grid.Column="0" Background="#11141E" BorderBrush="#1C212E" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Library Tab Switcher -->
                    <Border Grid.Row="0" Background="#161B26" Padding="6,6" BorderBrush="#1E2433" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button Grid.Column="0" Command="{Binding SetActiveTabCommand}" CommandParameter="Photos" Content="📷 Photos" Background="Transparent" Foreground="#CBD5E1" Padding="4,6" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding SetActiveTabCommand}" CommandParameter="Music" Content="🎵 Music" Background="Transparent" Foreground="#CBD5E1" Padding="4,6" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="2" Command="{Binding SetActiveTabCommand}" CommandParameter="Text" Content="🔤 Text" Background="Transparent" Foreground="#CBD5E1" Padding="4,6" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="3" Command="{Binding SetActiveTabCommand}" CommandParameter="Templates" Content="✨ Styles" Background="Transparent" Foreground="#CBD5E1" Padding="4,6" CornerRadius="6" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Library Content Area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" Spacing="12">
                            <!-- Section: Photos -->
                            <StackPanel Spacing="10" IsVisible="{Binding ActiveLibraryTab, Converter={x:Null}}">
                                <Button Click="OnAddPhotoFileClicked" Content="+ Add Photos to Project" Background="#4F46E5" Foreground="#FFFFFF" Padding="14,8" CornerRadius="8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="Project Photos" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding LibraryAssets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171C28" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#242C3E" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="📷" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="+ Insert" Background="#1E293B" Foreground="#60A5FA" Padding="8,4" CornerRadius="4" FontSize="11"
                                                                Click="OnAddLibraryAssetClicked"/>
                                                        <Button Content="🗑" Background="#1E293B" Foreground="#EF4444" Padding="6,4" CornerRadius="4" FontSize="11"
                                                                Click="OnRemoveAssetClicked"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Section: Music -->
                            <StackPanel Spacing="10">
                                <Button Click="OnAddMusicFileClicked" Content="+ Upload Background Music" Background="#059669" Foreground="#FFFFFF" Padding="14,8" CornerRadius="8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="Audio Tracks" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding AudioAssets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171C28" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#242C3E" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="🎵" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="🗑" Background="#1E293B" Foreground="#EF4444" Padding="6,4" CornerRadius="4" FontSize="11"
                                                            Click="OnRemoveAssetClicked"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Section: Text & Title Presets -->
                            <StackPanel Spacing="10">
                                <Button Command="{Binding AddTextToTimelineCommand}" Content="➕ Add Text at Playhead" Background="#7C3AED" Foreground="#FFFFFF" Padding="14,8" CornerRadius="8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="Animated Title Presets" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding TextPresets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171C28" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#242C3E" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <Button Grid.Column="1" Content="+ Insert" Background="#1E293B" Foreground="#818CF8" Padding="8,3" CornerRadius="4" FontSize="10" FontWeight="Bold"
                                                                Click="OnInsertTextPresetClicked"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8"/>
                                                    <Border Background="#0F131D" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding SampleText}" FontFamily="{Binding FontFamily}" FontSize="12" Foreground="{Binding ColorHex}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Section: Templates -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Apply Style / Template" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                                <ItemsControl ItemsSource="{Binding AvailableTemplates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171C28" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#242C3E" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <Button Grid.Column="1" Content="Apply" Background="#1E293B" Foreground="#38BDF8" Padding="8,3" CornerRadius="4" FontSize="10" FontWeight="Bold"
                                                                Click="OnApplyTemplateClicked"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center: Video Canvas Preview -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" Background="#0C0E14">
                <controls:VideoPreviewControl Grid.Row="0"
                                             Project="{Binding CurrentProject}"
                                             CurrentTime="{Binding CurrentTime}"
                                             Margin="16"/>

                <!-- Preview Transport Controls Bar -->
                <Border Grid.Row="1" Background="#11141D" Padding="16,10" BorderBrush="#1C212E" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Play/Pause Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding StepBackwardCommand}" Content="⏮" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="12"/>
                            <Button Command="{Binding PlayPauseCommand}" Background="#4F46E5" Foreground="#FFFFFF" Padding="16,6" CornerRadius="6" FontSize="13" FontWeight="Bold">
                                <TextBlock Text="▶ Play / ⏸ Pause"/>
                            </Button>
                            <Button Command="{Binding StepForwardCommand}" Content="⏭" Background="#1E2433" Foreground="#CBD5E1" Padding="10,6" CornerRadius="6" FontSize="12"/>
                        </StackPanel>

                        <!-- Timecode Display -->
                        <TextBlock Grid.Column="1" Text="{Binding TimecodeDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>

                        <!-- Zoom Slider -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Zoom" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Slider Minimum="20" Maximum="150" Value="{Binding TimelineZoom}" Width="100"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Contextual Property Inspector -->
            <Border Grid.Column="2" Background="#11141E" BorderBrush="#1C212E" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" Spacing="16">
                        <TextBlock Text="INSPECTOR" FontSize="12" FontWeight="ExtraBold" Foreground="#64748B"/>

                        <!-- Selected Clip Header & Action Buttons -->
                        <Border Background="#161B26" CornerRadius="10" Padding="14" BorderBrush="#232A3B" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Selected Clip" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedClip.Name, FallbackValue='No Clip Selected (Click timeline)'}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding SplitClipCommand}" Content="✂ Split (S)" Background="#1E2433" Foreground="#CBD5E1" Padding="10,5" CornerRadius="6" FontSize="11"/>
                                    <Button Command="{Binding DeleteClipCommand}" Content="🗑 Delete" Background="#1E2433" Foreground="#EF4444" Padding="10,5" CornerRadius="6" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inspector Panel: TEXT CLIP -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsTextClipSelected}">
                            <TextBlock Text="🔤 Text Properties &amp; Typography" FontSize="12" FontWeight="Bold" Foreground="#60A5FA"/>

                            <!-- Text Content -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text Content" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding SelectedTextClip.Overlay.Text}" Background="#161B26" Foreground="#FFFFFF" CornerRadius="8" Padding="10" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                            </StackPanel>

                            <!-- Font Family Dropdown -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Font Family" FontSize="11" Foreground="#94A3B8"/>
                                <ComboBox ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding SelectedTextClip.Overlay.FontFamily}" HorizontalAlignment="Stretch" Background="#161B26" Foreground="#FFFFFF" CornerRadius="8"/>
                            </StackPanel>

                            <!-- Font Size -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Font Size" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTextClip.Overlay.FontSize, StringFormat='{}{0:F0} px'}" FontSize="11" Foreground="#64748B"/>
                                </Grid>
                                <Slider Minimum="16" Maximum="120" Value="{Binding SelectedTextClip.Overlay.FontSize}"/>
                            </StackPanel>

                            <!-- Text Color Hex -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text Color (Hex)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding SelectedTextClip.Overlay.ColorHex}" Background="#161B26" Foreground="#FFFFFF" CornerRadius="6" Padding="8,4" FontSize="12"/>
                            </StackPanel>

                            <!-- Background Pill Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Background Pill Color (Hex)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding SelectedTextClip.Overlay.BackgroundColorHex}" Background="#161B26" Foreground="#FFFFFF" CornerRadius="6" Padding="8,4" FontSize="12"/>
                            </StackPanel>

                            <!-- Entry Animation -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Entry Animation" FontSize="11" Foreground="#94A3B8"/>
                                <ComboBox SelectedItem="{Binding SelectedTextClip.Overlay.EntryAnimation}" HorizontalAlignment="Stretch" Background="#161B26" Foreground="#FFFFFF" CornerRadius="8">
                                    <enums:TextAnimation>Fade</enums:TextAnimation>
                                    <enums:TextAnimation>Slide</enums:TextAnimation>
                                    <enums:TextAnimation>Pop</enums:TextAnimation>
                                    <enums:TextAnimation>Zoom</enums:TextAnimation>
                                    <enums:TextAnimation>Typewriter</enums:TextAnimation>
                                    <enums:TextAnimation>None</enums:TextAnimation>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Inspector Panel: PHOTO CLIP -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsImageClipSelected}">
                            <TextBlock Text="📸 Photo Properties &amp; Transforms" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>

                            <!-- Quick Rotate & Flip Toolbar -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Rotate &amp; Flip" FontSize="11" Foreground="#94A3B8"/>
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <Button Grid.Column="0" Command="{Binding RotateSelectedClipCommand}" CommandParameter="left" Content="↺ -90°" Background="#161B26" Foreground="#CBD5E1" Padding="2,6" Margin="0,0,3,0" CornerRadius="6" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding RotateSelectedClipCommand}" CommandParameter="right" Content="↻ +90°" Background="#161B26" Foreground="#CBD5E1" Padding="2,6" Margin="0,0,3,0" CornerRadius="6" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Command="{Binding FlipHorizontalSelectedClipCommand}" Content="⇄ Flip H" Background="#161B26" Foreground="#CBD5E1" Padding="2,6" Margin="0,0,3,0" CornerRadius="6" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="3" Command="{Binding FlipVerticalSelectedClipCommand}" Content="⇅ Flip V" Background="#161B26" Foreground="#CBD5E1" Padding="2,6" Margin="0,0,3,0" CornerRadius="6" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="4" Command="{Binding ResetTransformSelectedClipCommand}" Content="⟲ Reset" Background="#1E2433" Foreground="#94A3B8" Padding="2,6" CornerRadius="6" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Rotation Angle Slider -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Rotation Angle" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedImageClip.Transform.RotationDegrees, StringFormat='{}{0:F0}°'}" FontSize="11" Foreground="#64748B"/>
                                </Grid>
                                <Slider Minimum="-180" Maximum="180" Value="{Binding SelectedImageClip.Transform.RotationDegrees}"/>
                            </StackPanel>

                            <!-- Scale / Zoom Slider -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Scale / Zoom" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedImageClip.Transform.ScaleX, StringFormat='{}{0:F2}x'}" FontSize="11" Foreground="#64748B"/>
                                </Grid>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding SelectedImageClip.Transform.ScaleX}"/>
                            </StackPanel>

                            <!-- Motion Preset -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Photo Motion (Ken Burns)" FontSize="11" Foreground="#94A3B8"/>
                                <ComboBox SelectedItem="{Binding SelectedImageClip.Motion}" HorizontalAlignment="Stretch" Background="#161B26" Foreground="#FFFFFF" CornerRadius="8">
                                    <enums:MotionPreset>None</enums:MotionPreset>
                                    <enums:MotionPreset>ZoomIn</enums:MotionPreset>
                                    <enums:MotionPreset>ZoomOut</enums:MotionPreset>
                                    <enums:MotionPreset>PanLeft</enums:MotionPreset>
                                    <enums:MotionPreset>PanRight</enums:MotionPreset>
                                    <enums:MotionPreset>PanUp</enums:MotionPreset>
                                    <enums:MotionPreset>PanDown</enums:MotionPreset>
                                    <enums:MotionPreset>DiagonalDownRight</enums:MotionPreset>
                                    <enums:MotionPreset>Cinematic</enums:MotionPreset>
                                </ComboBox>
                            </StackPanel>

                            <!-- Crop Mode -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Crop Mode" FontSize="11" Foreground="#94A3B8"/>
                                <ComboBox SelectedItem="{Binding SelectedImageClip.CropMode}" HorizontalAlignment="Stretch" Background="#161B26" Foreground="#FFFFFF" CornerRadius="8">
                                    <enums:CropMode>BlurBackground</enums:CropMode>
                                    <enums:CropMode>Fit</enums:CropMode>
                                    <enums:CropMode>Fill</enums:CropMode>
                                    <enums:CropMode>CenterCrop</enums:CropMode>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Inspector Panel: AUDIO CLIP -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsAudioClipSelected}">
                            <TextBlock Text="🎵 Audio Track Controls" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Volume" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAudioClip.AudioSettings.Volume, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="#64748B"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" Value="{Binding SelectedAudioClip.AudioSettings.Volume}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Bottom Multi-Track Timeline Canvas -->
        <Border Grid.Row="3" Background="#0E1117" BorderBrush="#1C212E" BorderThickness="0,1,0,0">
            <controls:TimelineCanvasControl Project="{Binding CurrentProject}"
                                           PlayheadPosition="{Binding CurrentTime}"
                                           SelectedClip="{Binding SelectedClip, Mode=TwoWay}"
                                           PixelsPerSecond="{Binding TimelineZoom}"
                                           SeekRequested="OnTimelineSeekRequested"
                                           ClipSelectionChanged="OnTimelineClipSelectionChanged"/>
        </Border>
    </Grid>
</UserControl>
