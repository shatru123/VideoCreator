<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VideoCreator.App.ViewModels"
             xmlns:enums="using:VideoCreator.Core.Enums"
             x:Class="VideoCreator.App.Views.QuickCreateView"
             x:DataType="vm:QuickCreateViewModel"
             x:Name="QuickCreateRoot"
             Background="#0B0E14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="40,30,40,40" Spacing="28">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Command="{Binding BackToHomeCommand}" Background="#1E293B" Foreground="#E2E8F0" Padding="12,8" CornerRadius="8">
                    <TextBlock Text="← Back to Home" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Quick Create Video" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Turn photos and music into a video in 4 quick steps" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Step 1: Project Name & Photos -->
            <Border Background="#151923" CornerRadius="12" Padding="24" BorderBrush="#242B3A" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="1. Add Your Photos" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>

                    <TextBox Text="{Binding ProjectName}" Watermark="Project Name (e.g. Vacation Highlights)" Background="#0F121A" Foreground="#FFFFFF" Padding="12,10" CornerRadius="8" BorderBrush="#334155"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Photos.Count, StringFormat='Photos Added: {0}'}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Add Photo Files" Click="OnAddPhotosClicked" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" CornerRadius="8"/>
                    </Grid>

                    <!-- Photo List -->
                    <ItemsControl ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2433" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📷" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#E2E8F0" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Content="✕"
                                                Background="Transparent"
                                                Foreground="#EF4444"
                                                Padding="4,0"
                                                FontSize="11"
                                                Command="{Binding #QuickCreateRoot.((vm:QuickCreateViewModel)DataContext).RemovePhotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Step 2: Background Music -->
            <Border Background="#151923" CornerRadius="12" Padding="24" BorderBrush="#242B3A" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="2. Select Background Music (Optional)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding MusicFileName}" IsReadOnly="True" Background="#0F121A" Foreground="#CBD5E1" Padding="12,10" CornerRadius="8" BorderBrush="#334155"/>
                        <Button Grid.Column="1" Content="Browse Audio..." Click="OnSelectMusicClicked" Background="#1E293B" Foreground="#E2E8F0" FontWeight="SemiBold" Padding="16,10" Margin="10,0,0,0" CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 3: Template Style -->
            <Border Background="#151923" CornerRadius="12" Padding="24" BorderBrush="#242B3A" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="3. Choose Video Style" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <ListBox ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A202C" CornerRadius="10" Padding="16" Margin="0,0,12,12" Width="240" BorderBrush="#2D3748" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" MaxLines="2" Height="32"/>
                                        <TextBlock Text="{Binding DefaultMotion, StringFormat='Motion: {0}'}" FontSize="10" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Step 4: Aspect Ratio & Timing -->
            <Border Background="#151923" CornerRadius="12" Padding="24" BorderBrush="#242B3A" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="4. Canvas Aspect Ratio" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="RatioGroup" Content="16:9 Landscape (YouTube)" IsChecked="{Binding SelectedAspectRatio, Converter={x:Null}}" Tag="Ratio16x9" Foreground="#E2E8F0"/>
                        <RadioButton GroupName="RatioGroup" Content="9:16 Vertical (Reels / TikTok)" IsChecked="True" Foreground="#E2E8F0"/>
                        <RadioButton GroupName="RatioGroup" Content="1:1 Square (Post)" Foreground="#E2E8F0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status & Generate CTA -->
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,10,0,20">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#F59E0B" FontSize="13" HorizontalAlignment="Center" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Command="{Binding GenerateVideoCommand}"
                        Background="#4F46E5"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="16"
                        Padding="36,16"
                        CornerRadius="12"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎬 Generate Video Timeline" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
